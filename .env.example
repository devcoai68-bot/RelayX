# RelayX production configuration
# Copy to .env or inject these variables through your process manager/orchestrator.

# Bearer token required in Authorization: Bearer <token>. Keep secret; must differ from encryption key.
RELAYX_AUTH_TOKEN=change-me-auth-token

# Base64-encoded 32-byte ChaCha20-Poly1305 key. Keep secret; must differ from auth token.
RELAYX_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Client-side URL of the relay endpoint.
RELAYX_RELAY_URL=http://127.0.0.1:8000/relay

# Local HTTP proxy bind address and port for client mode.
RELAYX_PROXY_HOST=127.0.0.1
RELAYX_PROXY_PORT=8080

# Server bind address and port for server mode.
RELAYX_SERVER_HOST=0.0.0.0
RELAYX_SERVER_PORT=8000

# Structured log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
RELAYX_LOG_LEVEL=INFO

# Replay protection timing and cache sizing.
RELAYX_REPLAY_WINDOW_SECONDS=300
RELAYX_ALLOWED_CLOCK_SKEW_SECONDS=30
RELAYX_REPLAY_CACHE_MAX_ENTRIES=100000

# Compression controls.
RELAYX_COMPRESSION_ENABLED=true
RELAYX_COMPRESSION_THRESHOLD_BYTES=1024

# Maximum decoded/decompressed and carrier packet sizes, in bytes.
RELAYX_MAX_DECOMPRESSED_BYTES=134217728
RELAYX_MAX_CARRIER_BODY_BYTES=134217728
RELAYX_MAX_REQUEST_BODY_BYTES=16777216
RELAYX_MAX_RESPONSE_BODY_BYTES=67108864
RELAYX_MAX_HEADER_BYTES=65536

# Upstream and relay HTTP timeout, in seconds. Also used as the graceful shutdown drain window.
RELAYX_TIMEOUT_SECONDS=30
